# 개발 서버(vite)가 /api 요청을 넘겨줄 백엔드(FastAPI) 주소. 브라우저에는 노출되지 않는다.
# 운영은 vercel.json의 rewrites가 같은 역할을 한다.
API_PROXY_TARGET=http://localhost:8000

# 개발 서버(vite)가 /api/chat 요청을 넘겨줄 챗봇 서비스 주소. 챗봇은 백엔드와 별도 서비스다.
CHATBOT_PROXY_TARGET=http://localhost:8100

# Side Kick 자세 배우기 실행 모드. frontend_only면 API·DB 없이 JSON Runtime만 실행한다.
# 미설정 또는 다른 값이면 기존 API_CONNECTED 동작을 유지한다.
# VITE_SIDEKICK_STUDY_MODE=frontend_only
